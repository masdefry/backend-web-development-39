model Article {
  id        String      @id @default(cuid())
  title     String      @db.VarChar(150)
  content   String      @db.Text
  category  Category
  exerpt    String      @db.Text
  imageUrl  String 
  userId    String 
  users     User        @relation(fields: [userId], references: [id])
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  deletedAt DateTime?

  // users_has_articles    UserArticle[]

  @@map("articles")
}

enum Category {
  LIFESTYLE
  POLITIC 
  SPORT 
  FASHION 
  RELIGIOUS
}